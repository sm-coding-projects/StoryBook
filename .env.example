# S3 / MinIO (local defaults)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=gallery-originals
S3_DERIVATIVES_BUCKET=gallery-derivatives
S3_EXPORTS_BUCKET=gallery-exports
S3_FORCE_PATH_STYLE=true

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (dev: uses console sink)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@storybook.systems

# Stripe (feature-flagged)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Sentry (optional)
SENTRY_DSN=
